# Required. MET Norway rejects missing/non-identifying User-Agent values.
# Supply your app identifier and a contact method you control.
WEATHER_USER_AGENT=

# Optional. Bind address; default loopback. Compose sets 0.0.0.0 internally.
FIELDCALL_HOST=127.0.0.1
FIELDCALL_PORT=8080

# Optional persistent SQLite file.
DATABASE_PATH=data/fieldcall.sqlite3

# Optional provider timeout (seconds, 2..60).
WEATHER_TIMEOUT_SECONDS=12
