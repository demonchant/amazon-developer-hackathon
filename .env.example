# Required. MET Norway rejects missing/non-identifying User-Agent values.
# Supply your app identifier and a contact method you control.
WEATHER_USER_AGENT=

# Required. Create OAuth 2.0 Web application credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the authorized redirect URI configured in Google Cloud.
GOOGLE_REDIRECT_URI=https://fieldcall.onrender.com/auth/callback
# Required, random signing key for seven-day secure sessions. Generate locally with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=

# Optional. Bind address; default loopback. Compose sets 0.0.0.0 internally.
FIELDCALL_HOST=127.0.0.1
FIELDCALL_PORT=8080

# Optional persistent SQLite file.
DATABASE_PATH=data/fieldcall.sqlite3

# Optional provider timeout (seconds, 2..60).
WEATHER_TIMEOUT_SECONDS=12
